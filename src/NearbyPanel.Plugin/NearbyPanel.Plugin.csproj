<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NearbyPanel</AssemblyName>
    <RootNamespace>NearbyPanel</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Mono's JIT enforces access checks unless the assembly is marked
         SkipVerification. Set now so a future private-member access does not
         fail with a baffling MemberAccessException. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Path discovery: explicit value wins, then the Steam registry, then the
       standard install locations. r2modman and Gale keep BepInEx in a profile of
       their own rather than in the game folder, so probe that too. -->
  <PropertyGroup>
    <GamePath Condition="!Exists('$(GamePath)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 892970', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
    <_SteamLibraryPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamLibraryPath>
    <GamePath Condition="!Exists('$(GamePath)') AND '$(_SteamLibraryPath)' != ''">$(_SteamLibraryPath)\steamapps\common\Valheim</GamePath>
    <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>

    <ValheimManaged>$(GamePath)\valheim_Data\Managed</ValheimManaged>

    <BepInExPath Condition="!Exists('$(BepInExPath)\core') AND Exists('$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx\core')">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx</BepInExPath>
    <BepInExPath Condition="!Exists('$(BepInExPath)\core') AND Exists('$(GamePath)\BepInEx\core')">$(GamePath)\BepInEx</BepInExPath>

    <DeployPath Condition="'$(DeployPath)' == ''">$(BepInExPath)\plugins\NearbyPanel</DeployPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NearbyPanel.Core\NearbyPanel.Core.csproj" />
  </ItemGroup>

  <!-- Private=False on every one of these. Without it MSBuild copies ~60 MB of
       game and loader assemblies into bin/, and if that folder is ever deployed
       the Chainloader loads a SECOND copy of assembly_valheim / 0Harmony from a
       different path. The CLR treats those as distinct identities, which surfaces
       as InvalidCastException / MissingMethodException on types that look
       identical, and Harmony patching the wrong 0Harmony. -->
  <!-- A machine with no Valheim installed - CI, or anyone who just wants to build it -
       compiles against published reference assemblies instead. Their file names carry a
       -publicized suffix, but the assembly identity inside is unchanged, so the output
       binds to the real game assemblies at runtime. -->
  <ItemGroup Condition="'$(UseNuGetGameRefs)' == 'true'">
    <PackageReference Include="Digitalroot.Valheim.Common.References" Version="1.0.16" />
    <PackageReference Include="Digitalroot.References.Unity" Version="6000.0.75" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetGameRefs)' != 'true'">
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <!-- Localization lives here, not in assembly_valheim. -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <!-- TextAnchor and FontStyle, used by the GUIStyle the panel builds. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>False</Private><SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Deployment is opt-in: dotnet build -p:Deploy=true
       It must never be a side effect of a plain build. DeployPath points at a
       profile that is actually played on, and dropping a half-finished plugin
       there means it loads on the next launch. Prefer a separate r2modman profile
       for development and pass -p:BepInExPath to target it.
       Retries because Windows Defender briefly locks a freshly written DLL while
       it scans it. -->
  <Target Name="DeployToProfile" AfterTargets="Build"
          Condition="'$(Deploy)' == 'true' AND Exists('$(BepInExPath)\core')">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPath)"
          SkipUnchangedFiles="false" Retries="5" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="$(TargetDir)NearbyPanel.Core.dll" DestinationFolder="$(DeployPath)"
          SkipUnchangedFiles="false" Retries="5" RetryDelayMilliseconds="500" />
    <Copy Condition="'$(Configuration)' == 'Debug' AND Exists('$(TargetDir)$(TargetName).pdb')"
          SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployPath)"
          Retries="5" RetryDelayMilliseconds="500" />
    <Message Importance="high" Text="  $(AssemblyName) -> $(DeployPath)" />
  </Target>

</Project>
